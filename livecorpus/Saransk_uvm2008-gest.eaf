    <TIER ANNOTATOR="fffraggile" LINGUISTIC_TYPE_REF="gesture_organs"
        PARENT_REF="gestType@uvm2008f" PARTICIPANT="@uvm2008f" TIER_ID="gestLegs@uvm2008f"/>
    <TIER ANNOTATOR="fffraggile" LINGUISTIC_TYPE_REF="gesture_comment"
        PARENT_REF="gestType@uvm2008f" PARTICIPANT="@uvm2008f" TIER_ID="gestComment@uvm2008f">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a643" ANNOTATION_REF="a614">
                <ANNOTATION_VALUE>незначительное изменение положения головы и верхней части корпуса (плечи); смягчение выражение, высказывание предположения</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a564" ANNOTATION_REF="a523">
                <ANNOTATION_VALUE>небольшое движение плечей вверх, отнесено к органу Body по принципу отсутствия органа плечей</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a565" ANNOTATION_REF="a524">
                <ANNOTATION_VALUE>размечено поднятие бровей и закатывание глаз; отнесено к органу Haed по принципу отсутствия категории мимики</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a566" ANNOTATION_REF="a525">
                <ANNOTATION_VALUE>также выбран орган Body, посколько присутствует легкое покачивание корпусом</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a644" ANNOTATION_REF="a615">
                <ANNOTATION_VALUE>что-то типо "само собой", "очевидно" с оттенком небольшого извинения за упрощение</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a567" ANNOTATION_REF="a530">
                <ANNOTATION_VALUE>минимальное покачивание головой; оценка как что-то "невероятное"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a568" ANNOTATION_REF="a531">
                <ANNOTATION_VALUE>думала над вариантом эмблемы, однако кивки минимальны; они скорее подтверждают сказанное и подводят черту; идут вместе с речью, дублируя ее</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a645" ANNOTATION_REF="a532">
                <ANNOTATION_VALUE>адаптор, так как проявляется стремление к адаптации через поиск удобного положения </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a603" ANNOTATION_REF="a571">
                <ANNOTATION_VALUE>маркирует фразу как чужую, неискреннюю цитату и отдаляется от нее при помощи сарказма. отношение говорящего к сказанному(?) + типо маркера цитаты; отмечено Body, так как легкие покачивания в такт интонации</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a604" ANNOTATION_REF="a572">
                <ANNOTATION_VALUE>отнесла к категории указания на структуру дискруса, "а потом... ты узнаешь" - обозначает переход к развязке</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a605" ANNOTATION_REF="a573">
                <ANNOTATION_VALUE>для особой экспрессии на слове " просто нечестен"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a606" ANNOTATION_REF="a574">
                <ANNOTATION_VALUE>легкое покачивание из стороны в сторону, "приблизительно", "как-то так"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a607" ANNOTATION_REF="a575">
                <ANNOTATION_VALUE>как маркер структуры перечисления, добавления; акцент на "это тоже"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a608" ANNOTATION_REF="a576">
                <ANNOTATION_VALUE>были сомнения, что может быть прагматическим - маркировка перечисления; однако тут речь больше про создание образа последовательности, продолжения, "и так далее"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a646" ANNOTATION_REF="a620">
                <ANNOTATION_VALUE>что-то типо бита, выделение слова "качеством" + интонация</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a647" ANNOTATION_REF="a621">
                <ANNOTATION_VALUE>небольшое изменение положения руки с приподнятием плеча; маркер структуры дискурса</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a651" ANNOTATION_REF="a648">
                <ANNOTATION_VALUE>немного приподнимаются плечи; по контексту речь о качествах, которых может в реальности и не быть, поэтому жест означает некое отдаление и дистанцирование от сказанного; "якобы", "так считает он сам"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a609" ANNOTATION_REF="a577">
                <ANNOTATION_VALUE>легкое перебирание пальцами</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a613" ANNOTATION_REF="a610">
                <ANNOTATION_VALUE>небольшое движение головы сопровождает конец мысли; маркер структуры дискурса (конец рассказа)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
